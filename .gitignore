# macOS folder metadata
.DS_Store

# Local secrets and overrides. .env.example is committed on purpose as the template.
.env
.env.local

.claude

# Logs and TypeScript build info. These need the wildcard: a bare ".log" pattern matches only a
# file literally named ".log", so every actual server.log and tsconfig.tsbuildinfo was being
# offered up for commit.
*.log
*.tsbuildinfo

# Build output, all of it regenerated by `npm run build`.
build/
coverage/
dist/
node_modules/
